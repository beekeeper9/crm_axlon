# Скопируйте в .env.local и при необходимости измените значения.
# Все переменные NEXT_PUBLIC_* попадают в браузер — не храните здесь секреты.

# Источник данных: mock — демо-данные, api — Python backend
NEXT_PUBLIC_DATA_SOURCE=mock

# Базовый URL Python API (обязателен при NEXT_PUBLIC_DATA_SOURCE=api)
NEXT_PUBLIC_API_BASE_URL=

# В режиме mock вход — по тестовым учётным записям (mocks/demo-accounts.seed.ts)
